# ── Google Gemini (Opsiyonel - Ürün Analizi ve Stratejik Öneriler için) ──
# Almak için: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (Opsiyonel) Model adı. Google modelleri zaman zaman emekliye ayırdığı için
# boş bırakırsanız kod içindeki güncel varsayılan (gemini-3.7-flash) kullanılır.
GEMINI_MODEL_NAME=

# ── Anthropic Claude (Opsiyonel) ──
# Almak için: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=

# ── DeepSeek (Opsiyonel) ──
# Almak için: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=

# ── Qwen / Alibaba DashScope (Opsiyonel) ──
# Almak için: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=
QWEN_MODEL_NAME=

# ── Yerel kullanıcı hesapları dosyasının konumu (Opsiyonel) ──
# Varsayılan olarak proje klasöründe ".local_users.json" dosyasında saklanır
# (şifreler PBKDF2-SHA256 ile hashlenir, hiçbir zaman düz metin tutulmaz).
# Farklı bir konum/isim istiyorsanız burada belirtebilirsiniz.
APP_USER_STORE_PATH=

# Not: Yukarıdaki tüm API anahtarları opsiyoneldir. Hiçbiri girilmezse
# uygulama otomatik olarak dahili "Akıllı Heuristic AI Danışmanı" motorunu
# kullanır — hiçbir özellik API anahtarı olmadan devre dışı kalmaz.
